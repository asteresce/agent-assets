{
  "$schema": "https://opencode.ai/config.json",

  "model": "xiaomi-token-plan-sgp/mimo-v2.6-pro",
  "small_model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",

  "agent": {
    "plan": {
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    },

    "build": {
      "mode": "primary",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add*": "allow",
          "git commit*": "ask",
          "git push*": "deny",
          "rm -rf*": "deny"
        }
      }
    }
  }
}
